# Copiază fișierul ca .env și completează valorile. .env nu se commituie.
# Fără variabilele marcate OBLIGATORIU, procesul refuză să pornească.

# --- Secrete de sesiune (OBLIGATORIU) --------------------------------------
# Generează fiecare valoare separat, niciodată refolosită între medii:
#   openssl rand -base64 48
# Minim 32 de caractere. Rotirea lor deconectează toate sesiunile active.
SESSION_SECRET=
ADMIN_SESSION_SECRET=

# --- Cont de administrare (OBLIGATORIU) ------------------------------------
# Parola: minim 12 caractere, generată aleator, nu refolosită.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Supabase ---------------------------------------------------------------
# Cheia de service role ocolește RLS și trebuie să existe pe serverul deployat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- Stripe (OBLIGATORIU: primele două) -------------------------------------
# Fără cheia secretă nu se poate încasa nimic. Fără secretul de webhook nu se
# poate verifica semnătura, deci oricine poate trimite „plata a reușit".
# Procesul refuză să pornească dacă lipsesc.
#   Test:      sk_test_... / whsec_...
#   Producție: sk_live_... / whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Tipul de cont Connect. „express" = Stripe face KYC-ul, colectează IBAN-ul și
# găzduiește panoul fermierului. Schimbă doar dacă știi exact de ce.
STRIPE_CONNECT_ACCOUNT_TYPE=express

# --- Diverse ----------------------------------------------------------------
# Listă separată prin virgulă cu originile permise de CORS.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PEXELS_API_KEY=
PORT=3000
