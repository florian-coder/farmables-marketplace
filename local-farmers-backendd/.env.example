# Copiază fișierul ca .env și completează valorile. .env nu se commituie.
# Fără variabilele marcate OBLIGATORIU, procesul refuză să pornească.

# --- Secrete de sesiune (OBLIGATORIU) --------------------------------------
# Generează fiecare valoare separat, niciodată refolosită între medii:
#   openssl rand -base64 48
# Minim 32 de caractere. Rotirea lor deconectează toate sesiunile active.
SESSION_SECRET=
ADMIN_SESSION_SECRET=

# --- Cont de administrare (OBLIGATORIU) ------------------------------------
# Parola: minim 12 caractere, generată aleator, nu refolosită.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Supabase ---------------------------------------------------------------
# Cheia de service role ocolește RLS și trebuie să existe pe serverul deployat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Diverse ----------------------------------------------------------------
# Listă separată prin virgulă cu originile permise de CORS.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PEXELS_API_KEY=
PORT=3000
